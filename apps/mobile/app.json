{
  "expo": {
    "name": "AGAP",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spste10.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.spste10.mobile"
    },
    "scheme": "mobile",
    "extra": {
      "eas": {
        "projectId": "4e6befa7-41a5-4c31-80e9-fb36b03c0995"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "resizeMode": "contain"
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
